{
  "name": "tabshade",
  "version": "1.0.1",
  "description": "Firefox extension that shades the current browser tab to reduce its brightness.",
  "private": true,
  "homepage": "https://github.com/mfearby/tabshade",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "lint": "web-ext lint",
    "build": "npm run build:firefox",
    "build:firefox": "web-ext build --overwrite-dest",
    "build:chrome": "node scripts/build-chrome.mjs",
    "start": "web-ext run"
  },
  "devDependencies": {
    "web-ext": "^8.3.0",
    "webextension-polyfill": "^0.12.0"
  },
  "webExt": {
    "ignoreFiles": [
      "package.json",
      "package-lock.json",
      "lint-output.txt",
      "web-ext-artifacts",
      "README.md",
      "manifest.chrome.json",
      "scripts",
      "dist",
      "**/.DS_Store"
    ]
  }
}
