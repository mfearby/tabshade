{
  "name": "tabshade",
  "version": "1.0.0",
  "description": "Firefox extension that shades the current browser tab to reduce its brightness.",
  "private": true,
  "homepage": "https://github.com/mfearby/tabshade",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "lint": "web-ext lint",
    "build": "web-ext build --overwrite-dest",
    "start": "web-ext run"
  },
  "devDependencies": {
    "web-ext": "^8.3.0"
  },
  "webExt": {
    "ignoreFiles": [
      "package.json",
      "package-lock.json",
      "lint-output.txt",
      "web-ext-artifacts",
      "README.md",
      "**/.DS_Store"
    ]
  }
}
