{
  "description": "Shades current browser tab to reduce the brightness",
  "manifest_version": 3,
  "name": "TabShade",
  "version": "1.0.0",
  "homepage_url": "https://github.com/mfearby/tabshade",
  "icons": {
    "48": "icons/shader-48.png",
    "96": "icons/shader-96.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "scripts": ["background/background.js"]
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "commands": {
    "dim-increase": {
      "suggested_key": {
        "default": "Alt+Shift+Up"
      },
      "description": "Dim the current tab more"
    },
    "dim-decrease": {
      "suggested_key": {
        "default": "Alt+Shift+Down"
      },
      "description": "Dim the current tab less"
    },
    "toggle-shade": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Toggle shading on the current tab"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_scripts/shader.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tabshade@marcfearby.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_icon": "icons/shader-32.png",
    "theme_icons": [
      {
        "light": "icons/shader-32-light.png",
        "dark": "icons/shader-32.png",
        "size": 32
      }
    ],
    "default_title": "TabShade",
    "default_popup": "popup/popup.html"
  }
}